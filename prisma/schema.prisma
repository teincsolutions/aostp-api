// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  SUPER_ADMIN
  FINANCE_MANAGER
  OPERATIONS_CLERK
  PAYMENT_CLERK
  CUSTOMER
}

enum IdType {
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENSE
  VOTER_ID
  OTHER
}

enum PackageStatus {
  RECEIVED
  ASSIGNED
  SHIPPED
  ARRIVED
  RELEASED
}

enum ContainerStatus {
  PLANNED
  LOADED
  SHIPPED
  ARRIVED
  CLOSED
}

enum ShippingMode {
  SEA
  AIR
}

enum AirShippingType {
  NORMAL_AIR
  EXPRESS_AIR
  BATTERY_GOODS
  PHONES
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

enum PaymentGatewayStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum InvoiceStatus {
  PAID
  UNPAID
  PARTIALLY_PAID
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationType {
  PACKAGE_INTAKE
  INVOICE_ISSUED
  PAYMENT_RECEIVED
  SHIPMENT_UPDATE
  CONTAINER_ARRIVAL
  DELIVERY_RELEASED
}

enum ContainerType {
  CONTAINER // Sea freight
  BAG // Air freight
}

enum PackingListStatus {
  DRAFT // Initial state when created
  FINALIZED // Set when finalize endpoint is called
  POSTED // Future use
}

// Models
model User {
  id               String    @id @default(uuid())
  email            String    @unique
  username         String    @unique
  password         String
  firstName        String
  lastName         String
  role             UserRole
  warehouseId      String?
  isActive         Boolean   @default(true)
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLogin        DateTime?

  // Relations
  warehouse         Warehouse?        @relation(fields: [warehouseId], references: [id])
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  activityLogs      ActivityLog[]
  packagesCreated   Package[]         @relation("PackageCreatedBy")
  packagesUpdated   Package[]         @relation("PackageUpdatedBy")
  paymentsProcessed Payment[]         @relation("PaymentProcessedBy")
  exchangeRatesSet  ExchangeRate[]    @relation("ExchangeRateSetBy")
  deliveriesCreated PackageDelivery[] @relation("DeliveryCreatedBy")

  @@index([email])
  @@index([role])
  @@index([warehouseId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([token])
  @@index([userId])
}

model Warehouse {
  id          String   @id @default(uuid())
  warehouseId String   @unique // Manual or auto-generated
  name        String // e.g., China Main, Accra Branch
  location    String // Address
  contactInfo String? // phone/email
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  packageItems PackageItem[]
  packages     Package[]
  packingLists PackingList[]
  users        User[]

  @@index([warehouseId])
  @@index([isActive])
}

model Customer {
  id               String              @id @default(uuid())
  customerCode     String              @unique
  firstName        String
  lastName         String
  email            String?
  phoneNumber      String // Mandatory
  alternatePhone   String?
  address          String?
  city             String?
  country          String?
  idType           IdType?
  idNumber         String?
  preferredChannel NotificationChannel @default(EMAIL)
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  // Relations
  packages      Package[]
  packageItems  PackageItem[]
  invoices      Invoice[]
  payments      Payment[]
  notifications Notification[]
  deliveries    PackageDelivery[]

  @@unique([idType, idNumber])
  @@index([customerCode])
  @@index([email])
  @@index([phoneNumber])
  @@index([idNumber])
}

model PackageItem {
  id                 String           @id @default(uuid())
  intakeTrackingCode String           @unique // Scanned/entered at intake
  customerId         String
  customer           Customer         @relation(fields: [customerId], references: [id])
  warehouseId        String
  warehouse          Warehouse        @relation(fields: [warehouseId], references: [id])
  description        String
  notes              String?
  quantity           Int              @default(1)
  weight             Float? // in KG
  dimensions         String? // L x W x H
  cbm                Float? // Cubic meters
  shippingMode       ShippingMode
  airShippingType    AirShippingType?
  intakeDate         DateTime         @default(now())

  // Relations
  packageId String?
  package   Package?         @relation(fields: [packageId], references: [id])
  delivery  PackageDelivery?

  // Photos
  intakePhotos PackageItemPhoto[]

  @@index([intakeTrackingCode])
  @@index([customerId])
  @@index([warehouseId])
  @@index([packageId])
}

model PackageItemPhoto {
  id            String      @id @default(uuid())
  packageItemId String
  packageItem   PackageItem @relation(fields: [packageItemId], references: [id], onDelete: Cascade)
  url           String
  key           String // S3 key
  photoType     String      @default("intake") // intake, delivery
  uploadedAt    DateTime    @default(now())

  @@index([packageItemId])
}

model Package {
  id                String           @id @default(uuid())
  trackingCode      String           @unique
  customerId        String
  customer          Customer         @relation(fields: [customerId], references: [id])
  warehouseId       String?
  warehouse         Warehouse?       @relation(fields: [warehouseId], references: [id])
  description       String
  weight            Float? // in KG (computed from items)
  cbm               Float? // Cubic meters (computed from items)
  quantity          Int              @default(1)
  destinationCityId String? // Destination city for this package
  shippingRate      Float? // Rate per unit (per CBM for SEA, per KG for AIR)
  shippingCurrency  String           @default("USD") // Currency for shipping rate
  shippingCost      Float? // Per package shipping cost (rate * units * quantity)
  shippingMode      ShippingMode
  airShippingType   AirShippingType?
  isConsolidated    Boolean          @default(false) // True for parent packages
  status            PackageStatus    @default(RECEIVED)
  receivedDate      DateTime         @default(now())
  daysInWarehouse   Int              @default(0)
  photos            PackagePhoto[]
  notes             String?

  // Relations
  packingListId   String?
  packingList     PackingList? @relation(fields: [packingListId], references: [id])
  invoice         Invoice?
  destinationCity City?        @relation(fields: [destinationCityId], references: [id])

  // Two-table structure
  items PackageItem[]

  // Payment status
  paymentStatus PaymentStatus @default(PENDING)

  // Pickup code - unique and optional for package identification
  pickupCode String? @unique

  // Receipt
  receiptKey String? // S3 key for package intake receipt PDF

  // Audit fields
  createdById String
  createdBy   User     @relation("PackageCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?    @relation("PackageUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([trackingCode])
  @@index([customerId])
  @@index([warehouseId])
  @@index([status])
  @@index([packingListId])
}

model PackageDelivery {
  id            String      @id @default(uuid())
  deliveryId    String      @unique // Auto-generated
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  invoiceId     String
  invoice       Invoice     @relation(fields: [invoiceId], references: [id])
  packageItemId String
  packageItem   PackageItem @relation(fields: [packageItemId], references: [id])
  receiverName  String? // Optional receiver name
  quantity      Int         @default(1)
  warehouseId   String
  releaseDate   DateTime    @default(now())
  notes         String?
  photos        String[] // URLs for delivery photos

  // Relations
  createdById String
  createdBy   User   @relation("DeliveryCreatedBy", fields: [createdById], references: [id])

  @@unique([packageItemId], map: "PackageDelivery_packageItemId_unique")
  @@index([deliveryId])
  @@index([customerId])
  @@index([invoiceId])
}

model PackagePhoto {
  id         String   @id @default(uuid())
  packageId  String
  package    Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  url        String
  key        String // S3 key
  uploadedAt DateTime @default(now())

  @@index([packageId])
}

model City {
  id        String   @id @default(uuid())
  name      String
  country   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  shippingRates         ShippingRate[]
  departureContainers   Container[]    @relation("ContainerDepartureCity")
  destinationContainers Container[]    @relation("ContainerDestinationCity")
  destinationPackages   Package[]

  @@unique([name, country])
  @@index([country])
}

model ShippingRate {
  id              String           @id @default(uuid())
  shippingMode    ShippingMode
  airShippingType AirShippingType?
  cityId          String
  city            City             @relation(fields: [cityId], references: [id])
  ratePerUnit     Float // Per CBM for sea, per KG for air
  currency        String           @default("USD")
  effectiveFrom   DateTime         @default(now())
  effectiveTo     DateTime?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([shippingMode, airShippingType, cityId, effectiveFrom])
  @@index([shippingMode, isActive])
}

model Container {
  id                String          @id @default(uuid())
  containerNumber   String          @unique
  containerType     ContainerType // For air/sea mode filtering
  loadingDate       DateTime
  departureCityId   String // Departure city reference
  departureCity     City            @relation("ContainerDepartureCity", fields: [departureCityId], references: [id])
  destinationCityId String // Destination city reference
  destinationCity   City            @relation("ContainerDestinationCity", fields: [destinationCityId], references: [id])
  eta               DateTime // Estimated arrival (40-45 days)
  actualArrival     DateTime?
  status            ContainerStatus @default(PLANNED)
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  packingLists PackingList[]

  @@index([containerNumber])
  @@index([status])
  @@index([containerType])
}

model PackingList {
  id                String            @id @default(uuid())
  name              String            @unique // Default to loading date
  containerId       String
  container         Container         @relation(fields: [containerId], references: [id])
  warehouseId       String?
  warehouse         Warehouse?        @relation(fields: [warehouseId], references: [id])
  eta               DateTime? // Estimated time of arrival
  loadingDate       DateTime
  status            PackingListStatus @default(DRAFT) // Status of packing list
  totalPackages     Int               @default(0)
  totalCustomers    Int               @default(0)
  totalCBM          Float             @default(0)
  totalWeight       Float             @default(0)
  totalShippingCost Float             @default(0)
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Relations
  packages Package[]
  invoices Invoice[]

  @@index([containerId])
  @@index([warehouseId])
  @@index([status])
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  packingListId String? // Optional - invoices can exist without packing lists
  packingList   PackingList?  @relation(fields: [packingListId], references: [id])
  packageId     String? // One invoice per package
  package       Package?      @relation(fields: [packageId], references: [id])
  totalAmount   Float
  currency      String        @default("USD")
  exchangeRate  Float         @default(1)
  localAmount   Float // Amount in local currency
  status        InvoiceStatus @default(UNPAID)
  dueDate       DateTime
  paidAmount    Float         @default(0)
  balance       Float         @default(0) // Outstanding balance: totalAmount - paidAmount
  invoicePdfKey String? // S3 key for invoice PDF
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  payments   Payment[]
  deliveries PackageDelivery[]

  @@unique([packageId], map: "Invoice_packageId_unique")
  @@index([invoiceNumber])
  @@index([customerId])
  @@index([packageId])
  @@index([status])
}

model Payment {
  id             String       @id @default(uuid())
  paymentCode    String       @unique
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  amount         Float
  currency       String
  exchangeRateId String
  exchangeRate   ExchangeRate @relation(fields: [exchangeRateId], references: [id])
  localAmount    Float
  paymentMethod  String // CASH, BANK_TRANSFER, MOBILE_MONEY, etc.
  reference      String? // Transaction reference
  notes          String?
  processedById  String
  processedBy    User         @relation("PaymentProcessedBy", fields: [processedById], references: [id])
  processedAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())

  // Gateway integration fields
  gatewayTransactionId String? // ID from payment gateway (e.g. Hubtel checkout ID)
  gatewayStatus        PaymentGatewayStatus? // Status from payment gateway

  // Receipt
  receiptKey String? // S3 key for payment receipt PDF

  // Relations
  invoices Invoice[]

  @@index([paymentCode])
  @@index([customerId])
}

model ExchangeRate {
  id            String    @id @default(uuid())
  fromCurrency  String    @default("USD")
  toCurrency    String
  rate          Float
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  setById       String
  setBy         User      @relation("ExchangeRateSetBy", fields: [setById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  payments Payment[]

  @@unique([fromCurrency, toCurrency, effectiveFrom])
  @@index([isActive])
}

model Notification {
  id         String              @id @default(uuid())
  customerId String
  customer   Customer            @relation(fields: [customerId], references: [id])
  type       NotificationType
  channel    NotificationChannel
  recipient  String // Email or phone number
  subject    String?
  content    String
  status     String              @default("PENDING") // PENDING, SENT, FAILED
  sentAt     DateTime?
  failReason String?
  metadata   Json? // Additional data
  createdAt  DateTime            @default(now())

  @@index([customerId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // CREATE, UPDATE, DELETE, STATUS_CHANGE
  entity    String // Model name
  entityId  String // ID of the affected record
  before    Json? // Previous values
  after     Json? // New values
  metadata  Json? // Additional context
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([timestamp])
}

model ActivityLog {
  id            String   @id @default(uuid())
  level         String // error, warn, info, debug
  message       String
  correlationId String?
  timestamp     DateTime @default(now())
  userId        String? // If associated with user action
  user          User?    @relation(fields: [userId], references: [id])
  ipAddress     String?
  userAgent     String?
  method        String? // HTTP method
  url           String? // Request URL
  statusCode    Int? // Response status
  responseTime  Int? // Response time in ms
  metadata      Json? // Additional data
  error         String? // Error message if any

  @@index([level])
  @@index([timestamp])
  @@index([correlationId])
  @@index([userId])
}
