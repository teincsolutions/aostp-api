# Application
NODE_ENV=$NODE_ENV
PORT=3000
API_VERSION=v1
FRONTEND_URL=$FRONTEND_URL

# Database
DATABASE_URL=$DATABASE_URL

# JWT
JWT_SECRET=$JWT_SECRET
JWT_REFRESH_SECRET=$JWT_REFRESH_SECRET
JWT_EXPIRATION=$JWT_EXPIRATION
JWT_REFRESH_EXPIRATION=$JWT_REFRESH_EXPIRATION

# AWS S3
AWS_REGION=$AWS_REGION
AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY
AWS_S3_BUCKET_NAME=$AWS_S3_BUCKET_NAME
AWS_PACKAGES_BUCKET_NAME=$AWS_PACKAGES_BUCKET_NAME
AWS_USERS_BUCKET_NAME=$AWS_USERS_BUCKET_NAME
AWS_LOGS_BUCKET_NAME=$AWS_LOGS_BUCKET_NAME
AWS_S3_ENDPOINT=$AWS_S3_ENDPOINT

# CDN Domain-based S3 Access (for photo viewing through nginx subdomain)
CDN_DOMAIN=$CDN_DOMAIN

# CORS
CORS_ORIGIN=$CORS_ORIGIN

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Encryption
ENCRYPTION_KEY=$ENCRYPTION_KEY

# Email Provider (Optional - pluggable)
EMAIL_PROVIDER=nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=$SMTP_USER
SMTP_PASS=$SMTP_PASS
SMTP_SECURE=true
EMAIL_FROM=$EMAIL_FROM

# SMS Provider (Optional - pluggable)
SMS_PROVIDER=$SMS_PROVIDER

# Twilio SMS Provider
TWILIO_ACCOUNT_SID=$TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=$TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+1234567890

# Hubtel SMS Provider
HUBTEL_SMS_BASE_URL=https://sms.hubtel.com/v1
HUBTEL_CLIENT_ID=$HUBTEL_CLIENT_ID
HUBTEL_CLIENT_SECRET=$HUBTEL_CLIENT_SECRET
HUBTEL_SENDER_ID=Akomapa

# Arkesel SMS Provider
ARKESEL_API_KEY=$ARKESEL_API_KEY
ARKESEL_SENDER_ID=$ARKESEL_SENDER_ID

# AWS SNS SMS Provider
AWS_SNS_REGION=$AWS_SNS_REGION
AWS_SNS_ACCESS_KEY_ID=$AWS_SNS_ACCESS_KEY_ID
AWS_SNS_SECRET_ACCESS_KEY=$AWS_SNS_SECRET_ACCESS_KEY
AWS_SNS_SENDER_ID=$AWS_SNS_SENDER_ID

# SMS Online GH Provider
SMS_ONLINE_GH_API_KEY=$SMS_ONLINE_GH_API_KEY
SMS_ONLINE_GH_SENDER_ID=$SMS_ONLINE_GH_SENDER_ID

# WhatsApp Cloud API (for incoming webhook)
WHATSAPP_ACCESS_TOKEN=$WHATSAPP_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=$WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_VERIFY_TOKEN=$WHATSAPP_VERIFY_TOKEN
WHATSAPP_APP_SECRET=$WHATSAPP_APP_SECRET

# Payment Gateway (Optional - pluggable)
PAYMENT_PROVIDER=hubtel
HUBTEL_BASE_URL=https://invoicing.hubtel.com
HUBTEL_POS_SALES_ID=$HUBTEL_POS_SALES_ID
HUBTEL_API_ID=$HUBTEL_API_ID
HUBTEL_API_KEY=$HUBTEL_API_KEY
HUBTEL_CALLBACK_URL=https://api.akomapacargo.com/api/v1/payments/hubtel/callback

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_UPLOAD_INTERVAL_MINUTES=60

# Monitoring (Optional)
SENTRY_DSN=your-sentry-dsn

# Company Information (Optional - defaults used if not provided)
COMPANY_NAME=AKOMAPA CARGO (AOSTP)
COMPANY_PHONE=053777 6709
COMPANY_BRANCHES=ACCRA, KUMASI, HO, TAKORADI
COMPANY_EMAIL=info@akomapacargo.com
COMPANY_LOGO_PATH=./src/assets/logo.png

# Redis (for BullMQ queues)
REDIS_HOST=redis
REDIS_PORT=6379